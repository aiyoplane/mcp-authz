{
  "deploy_to_staging": {
    "aiyo_gated": true,
    "action": {
      "type": "deploy",
      "target": "staging"
    },
    "description": "Deploy the current build to the staging environment.",
    "input_schema": {
      "type": "object",
      "properties": {
        "pr_number": { "type": "integer", "description": "Pull request number to deploy" },
        "commit_sha": { "type": "string", "description": "Commit SHA being deployed" }
      },
      "required": ["pr_number", "commit_sha"]
    }
  },
  "deploy_to_production": {
    "aiyo_gated": true,
    "action": {
      "type": "deploy",
      "target": "production"
    },
    "description": "Deploy the current build to the production environment.",
    "input_schema": {
      "type": "object",
      "properties": {
        "pr_number": { "type": "integer", "description": "Pull request number to deploy" },
        "commit_sha": { "type": "string", "description": "Commit SHA being deployed" }
      },
      "required": ["pr_number", "commit_sha"]
    }
  },
  "charge_customer": {
    "aiyo_gated": true,
    "action": {
      "type": "payment"
    },
    "amount": "args.amount_cents",
    "currency": "usd",
    "description": "Charge a customer for a fixed amount.",
    "input_schema": {
      "type": "object",
      "properties": {
        "customer_id": { "type": "string" },
        "amount_cents": { "type": "integer", "minimum": 1 }
      },
      "required": ["customer_id", "amount_cents"]
    }
  },
  "search_docs": {
    "aiyo_gated": false,
    "description": "Search internal documentation. Read-only, no authorization required.",
    "input_schema": {
      "type": "object",
      "properties": {
        "query": { "type": "string" }
      },
      "required": ["query"]
    }
  }
}
